<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@23.1.0/build/css/intlTelInput.css">
<script src="https://cdn.jsdelivr.net/npm/intl-tel-input@23.1.0/build/js/intlTelInput.min.js"></script>

<style>
  span.phonenumber.form-inline {
    display: flex;
    width: 100%;
  }

  .iti__selected-country {
    padding: 0 !important;
    margin: 0 !important;
    height: 100% !important;
  }

  .iti--inline-dropdown {
    position: relative;
    z-index: 999;
  }

  .form-group .phonenumber.form-inline {
    border: 1px solid #ccc;
    border-radius: 4px;
  }

  .init-tel-input {
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    border: none !important;
  }
</style>

<script>
  $(function () {
    const errorMap = {"Invalid number":"N\u00famero inv\u00e1lido","Invalid country code":"C\u00f3digo de pa\u00eds inv\u00e1lido","Too short":"Demasiado corto","Too long":"N\u00famero muy largo"};
    const placeholderText = "Ej:";

    window.intlTelInputGlobals = {};

    function initIntlTelInput() {
      console.log('Initializing intl-tel-input...');
      const $inputs = $('.init-tel-input');
      const modalContainer = $inputs.closest('.modal-body');
      const isMobile = /Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent);

      $inputs.each(function () {
        const $input = $(this);
        const inputId = $input.attr('id');

        if (window.intlTelInputGlobals[inputId]) {
          window.intlTelInputGlobals[inputId].destroy();
        }

        const defaultCountry = $input.data('default-country') || 'auto';
        const prefixPhone = $input.val().substring(0,2);

        const itiInstance = window.intlTelInput(this, {
          utilsScript: "https://cdn.jsdelivr.net/npm/intl-tel-input@23.1.0/build/js/utils.js",
          initialCountry: defaultCountry,
          strictMode: true,
          i18n: {
            searchPlaceholder: "Buscar",
          },
          customPlaceholder: function (selectedCountryPlaceholder) {
            return placeholderText + ' ' + selectedCountryPlaceholder;
          },
          dropdownContainer: isMobile && modalContainer.length > 0 ? modalContainer[0] : null,
        });

        if (defaultCountry === 'auto' && prefixPhone === '00') {
          const phoneNumber = `+${$input.val().substring(2, $input.val().length)}`;
          itiInstance.setNumber(phoneNumber);
        }

        window.intlTelInputGlobals[inputId] = itiInstance;

        $input.on('input', function () {
          const selectedData = itiInstance.getSelectedCountryData();
          const fullNumber = itiInstance.getNumber();
          const dialCode = selectedData?.dialCode || '';
          const localNumber = fullNumber.substring(dialCode.length + 1);

          const phoneInputName = $input.data('phonenumber');
          const codeInputName = $input.data('countrycode');

          $(`[name="${phoneInputName}"]`).val(localNumber);
          $(`[name="${codeInputName}"]`).val("00" + dialCode);
        });

        const $parentGroup = $input.closest('div.input-group');
        if ($parentGroup.length) {
          $parentGroup.css('z-index', 999);
        }
      });
    }

    function validatePhoneInput($input) {
      const result = { status: true, message: '' };

      if (!$input || !$input.length) return result;

      const itiInstance = window.intlTelInputGlobals[$input.prop('id')];
      if (!itiInstance?.isValidNumber()) {
        const errorCode = itiInstance.getValidationError();
        const message = Object.values(errorMap)[errorCode] || "Número inválido";
        return { status: false, message };
      }

      return result;
    }

    $(window).on('load', initIntlTelInput);
    window.bindIntlTelInput = initIntlTelInput;
    window.validatePhoneInput = validatePhoneInput;
  });
</script>  <script>(function(){function c(){var b=a.contentDocument||a.contentWindow.document;if(b){var d=b.createElement('script');d.innerHTML="window.__CF$cv$params={r:'a156d24b2de487af',t:'MTc4MzA5MTQ3Mw=='};var a=document.createElement('script');a.src='/cdn-cgi/challenge-platform/scripts/jsd/main.js';document.getElementsByTagName('head')[0].appendChild(a);";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body>
